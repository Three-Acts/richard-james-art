---
import { ClientRouter } from 'astro:transitions'
import Seo, { type Props as SeoProps } from '@/components/Seo.astro'
import Nav from '@/components/Nav.astro'
import Footer from '@/components/Footer.astro'
import Preloader from '@/components/Preloader.astro'
import '@/styles/global.css'

export interface Props extends SeoProps {
  /** Let the nav sit transparent on the art until scrolled (home only). */
  transparentNav?: boolean
  /** Home ends on its own stage, so it omits the footer. */
  showFooter?: boolean
}

/**
 * App shell: smooth scroll, fixed navigation, the once-per-session preloader,
 * page content and the footer. Rendered for every route.
 *
 * ClientRouter keeps navigation feeling like the single-page app this replaced —
 * no white flash, and the Lenis instance created in scripts/shell.ts survives
 * across pages because <html> is never torn down.
 */
const { transparentNav = false, showFooter = true, ...seo } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5KHFFF3L');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Quattrocento:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Flags that JavaScript is available, before first paint. The scroll-reveal
         and image-fade start-states in global.css are gated on it, so a visitor
         without JS (or with a failed bundle) gets the page fully visible rather
         than a screen of content stuck at opacity 0. -->
    <script is:inline>
      document.documentElement.dataset.js = ''
    </script>

    <Seo {...seo} />
    <ClientRouter />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5KHFFF3L"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <Preloader />
    <Nav transparent={transparentNav} />

    <!-- `isolate` keeps the page's own stacking context (the home stage stacks
         its heroes / vignette / title plate as high as z-130) contained, so it
         can never paint over the fixed Nav (z-70), Menu (z-80) or Preloader
         (z-100). Without it those internal z-indices escape to the root and the
         art covers the open menu / hides the intro. -->
    <main id="main" class="isolate">
      <slot />
    </main>

    {showFooter && <Footer />}

    <script>
      import '@/scripts/shell'
    </script>
  </body>
</html>
