---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/project/Hero.astro'
import ProjectMeta from '@/components/project/ProjectMeta.astro'
import Gallery from '@/components/project/Gallery.astro'
import ProjectPager from '@/components/project/ProjectPager.astro'
import { previousBySlug, projects, projectsBySlug } from '@/data/projects'
import { artworkJsonLd, breadcrumbJsonLd } from '@/lib/structuredData'

/**
 * Project detail — cinematic, dark, normal Lenis scroll.
 * Hero → ProjectMeta → Gallery → ProjectPager (previous / next work).
 *
 * One static page per slug, exactly as before; the route table that
 * vite-react-ssg needed is now just this file plus getStaticPaths.
 */
export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i + 1 },
  }))
}

const { project, index } = Astro.props

const next = projectsBySlug[project.next] ?? projects[0]
const prev = previousBySlug[project.slug] ?? projects[projects.length - 1]
---

<Base
  title={project.title}
  description={project.metaDescription}
  path={`/projects/${project.slug}`}
  type="article"
  jsonLd={[
    artworkJsonLd({
      title: project.title,
      description: project.description,
      image: project.hero,
      medium: project.medium,
      year: project.year,
      slug: project.slug,
    }),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: project.title, path: `/projects/${project.slug}` },
    ]),
  ]}
>
  <article>
    <Hero project={project} index={index} total={projects.length} />
    <ProjectMeta project={project} />
    <Gallery project={project} />
    <ProjectPager prev={prev} next={next} />
  </article>
</Base>
